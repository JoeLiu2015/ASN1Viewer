<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ASN1Viewer.macOS" xmlns:ui="using:ASN1Viewer.macOS.ui" x:Class="ASN1Viewer.macOS.MainForm"
        Title="ASN1Viewer" Width="1200" Height="760" MinWidth="1100" MinHeight="520"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="PreferSystemChrome,OSXThickTitleBar" ExtendClientAreaTitleBarHeightHint="64"
        Icon="avares://ASN1Viewer.macOS/files/Icons/AppIcon.png"
        Background="#FAFBFD" Foreground="#252938" FontFamily=".AppleSystemUIFont, Helvetica Neue" FontSize="13" RequestedThemeVariant="Light">
  <Window.Styles>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="9"/><Setter Property="Background" Value="#FCFDFE"/>
      <Setter Property="BorderBrush" Value="#DFE3EA"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#E9EFF8"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#007AFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#007AFF"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#0065D8"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.active"><Setter Property="Background" Value="#DCEBFF"/><Setter Property="BorderBrush" Value="#87BAFF"/></Style>
    <Style Selector="TreeViewItem">
      <Setter Property="Template"><ControlTemplate>
        <StackPanel>
          <Border x:Name="NodeRow" CornerRadius="6" Padding="5,3" MinHeight="29">
            <Grid ColumnDefinitions="20,*">
              <ToggleButton x:Name="PART_ExpandCollapseChevron" Width="18" Height="20" MinHeight="0" Padding="0"
                IsVisible="{TemplateBinding ItemsSource, Converter={x:Static local:TreeConverters.HasChildren}}"
                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate>
                  <TextBlock x:Name="Chevron" Text="›" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ControlTemplate></ToggleButton.Template>
                <ToggleButton.Styles><Style Selector="ToggleButton:checked /template/ TextBlock#Chevron"><Setter Property="Text" Value="⌄"/></Style></ToggleButton.Styles>
              </ToggleButton>
              <ContentPresenter x:Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ItemsPresenter x:Name="PART_ItemsPresenter" IsVisible="{TemplateBinding IsExpanded}" Margin="18,0,0,0"/>
        </StackPanel>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border#NodeRow"><Setter Property="Background" Value="#E3E9F2"/></Style>
    <Style Selector="TreeViewItem:selected /template/ Border#NodeRow"><Setter Property="Background" Value="#007AFF"/></Style>
    <Style Selector="TreeViewItem:selected"><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="18,6"/><Setter Property="MinHeight" Value="30"/>
      <Setter Property="Template"><ControlTemplate><Border x:Name="Segment" Background="#EFF1F5" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0"><ContentPresenter Content="{TemplateBinding Header}"/></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="TabItem:selected /template/ Border#Segment"><Setter Property="Background" Value="#007AFF"/></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="White"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="64,*,34">
    <Border Background="#F3F5F9" BorderBrush="#DFE3EA" BorderThickness="0,0,0,1" Padding="88,0,16,0" PointerPressed="HeaderPointerPressed">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="ASN1Viewer" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
        <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="310,1,*">
      <Border Background="#F0F3F8" Padding="12,16,12,8">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock x:Name="StructureTitle" Text="Structure" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,6"/>
          <TextBlock x:Name="DocumentName" Grid.Row="1" Text="ASN.1" Foreground="#737D90" Margin="8,0,8,12" TextTrimming="CharacterEllipsis"/>
          <TreeView x:Name="Tree" Grid.Row="2" Background="Transparent" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:CompileBindings="False"><Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}"/></Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="local:NodeItem" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="17,*" ColumnSpacing="8">
                  <ui:VectorIcon Kind="{Binding IconKind}" Width="17" Height="17" VerticalAlignment="Center"
                    x:CompileBindings="False" Selected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"/>
                  <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" VerticalAlignment="Center"/>
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" Background="#DDE2EA"/>
      <Border Grid.Column="2" Background="White" Padding="18,16,18,10">
        <TabControl x:Name="Tabs" SelectedIndex="0" Padding="0">
          <TabItem x:Name="InputTab" Header="Input Text">
            <TextBox x:Name="Input" Margin="0,12,0,0" AcceptsReturn="True" TextChanged="InputChanged" FontFamily="Menlo,Consolas,monospace"
              FontSize="13" Padding="14" Background="#FCFDFE" BorderThickness="1" BorderBrush="#E3E7EE" CornerRadius="8"
              TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </TabItem>
          <TabItem x:Name="BytesTab" Header="ASN.1 Bytes">
            <Grid RowDefinitions="24,*,26" Margin="0,10,0,0">
              <TextBlock Text="{Binding Text, ElementName=DocumentName}" Foreground="#737D90" FontSize="12"/>
              <Border Grid.Row="1" BorderBrush="#E3E7EE" BorderThickness="1" CornerRadius="6" Padding="4,0,4,4" ClipToBounds="True"><ui:HexViewer x:Name="Hex"/></Border>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="● Tag" Foreground="#D64550"/><TextBlock Text="● Length" Foreground="#007AFF"/><TextBlock Text="● Value" Foreground="#22854D"/>
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#F3F5F9" BorderBrush="#DFE3EA" BorderThickness="0,1,0,0" Padding="18,0">
      <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="Status" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="StatusRight" Grid.Column="1" VerticalAlignment="Center" Foreground="#667187" Margin="12,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
