<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>true</UseAppHost>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="files/Icons/**" />
    <AvaloniaResource Include="../ASN1Viewer/lang/*.txt" Link="lang/%(Filename)%(Extension)" />
    <Compile Remove="Core/**;Tests/**;UITests/**" />
    <ProjectReference Include="Core/ASN1Viewer.Core.Modern.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <Content Include="../ASN1Viewer/files/TestFiles/*" Link="files/TestFiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
