<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ASN1Viewer.macOS.ui.MsgBox" Width="430" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" RequestedThemeVariant="Light">
  <StackPanel Margin="20" Spacing="20">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OKButton" Content="OK" Click="OKClicked" MinWidth="80" />
      <Button x:Name="CancelButton" Content="Cancel" Click="CancelClicked" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>
