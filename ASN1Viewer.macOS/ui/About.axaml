<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ASN1Viewer.macOS.ui.About" Width="450" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" RequestedThemeVariant="Light">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock x:Name="ProductName" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="Copyright" />
    <TextBlock x:Name="Build" />
    <Button x:Name="OK" Content="OK" Click="CloseClicked" HorizontalAlignment="Right" MinWidth="80" />
  </StackPanel>
</Window>
